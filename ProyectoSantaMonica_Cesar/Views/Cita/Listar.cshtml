@model IEnumerable<ProyectoSantaMonica_Cesar.Models.Cita>
@using ProyectoSantaMonica_Cesar.Models.enums

@{
    ViewData["Title"] = "Listado de Citas";


bool verTodas = ViewBag.VerTodas != null &&
        (bool)ViewBag.VerTodas;

    string? texto = ViewBag.Texto as string;

    bool hayBusqueda = !string.IsNullOrWhiteSpace(texto);

}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet">

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container mt-4">

    <div class="card shadow-sm rounded-4 border-0">

        <!-- ENCABEZADO -->

        <div class="card-header bg-primary text-white rounded-top-4
                d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                <i class="bi bi-calendar-check me-2"></i>
                Listado de Citas
            </h5>

            <span class="badge bg-light text-primary">
                @(verTodas || hayBusqueda ? "Todas las citas" : "Pendientes")
            </span>

        </div>


        <div class="card-body">

            <!-- BOTONES -->

            <div class="d-flex justify-content-between
                    align-items-center mb-3">

                <a asp-action="Registrar"
                   class="btn btn-success">

                    <i class="bi bi-plus-circle me-1"></i>
                    Registrar cita

                </a>


                @if (!hayBusqueda)
                {
                    @if (!verTodas)
                    {
                        <a asp-action="Listar"
                           asp-route-verTodas="true"
                           class="btn btn-outline-primary">

                            <i class="bi bi-list-ul me-1"></i>
                            Ver todas

                        </a>
                    }
                    else
                    {
                        <a asp-action="Listar"
                           asp-route-verTodas="false"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-1"></i>
                            Ver pendientes

                        </a>
                    }
                }

            </div>


            <!-- BÚSQUEDA -->

            <form asp-action="Listar"
                  method="get"
                  class="mb-4">

                <input type="hidden"
                       name="verTodas"
                       value="@verTodas" />

                <div class="input-group">

                    <input type="text"
                           name="texto"
                           class="form-control"
                           value="@texto"
                           placeholder="Buscar paciente, DNI, médico, fecha o motivo..." />

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search me-1"></i>
                        Buscar

                    </button>

                    @if (hayBusqueda)
                    {
                        <a asp-action="Listar"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-x-circle me-1"></i>
                            Limpiar

                        </a>
                    }

                </div>

            </form>


            <!-- TABLA -->

            <div class="table-responsive">

                <table class="table table-hover table-bordered
                          text-center align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>Paciente</th>

                            <th>Médico</th>

                            <th>Fecha</th>

                            <th>Hora</th>

                            <th>Motivo</th>

                            <th>Estado</th>

                            <th style="width: 170px;">
                                Acciones
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var cita in Model)
                            {
                                string badge = cita.Estado switch
                                {
                                    EstadoCita.PAGADO =>
                                    "bg-success",

                                    EstadoCita.PENDIENTE =>
                                    "bg-warning text-dark",

                                    EstadoCita.CANCELADO =>
                                    "bg-danger",

                                    EstadoCita.VENCIDO =>
                                    "bg-secondary",

                                    EstadoCita.ATENDIDO =>
                                    "bg-info text-dark",

                                    _ =>
                                    "bg-dark"
                                };


                                <tr>

                                    <!-- PACIENTE -->

                                    <td>

                                        @if (cita.Paciente != null)
                                        {
                                            <span class="fw-semibold">
                                                @cita.Paciente.Nombres
                                                @(" ")
                                                @cita.Paciente.Apellidos
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Sin datos
                                            </span>
                                        }

                                    </td>


                                    <!-- MÉDICO -->

                                    <td>

                                        @if (cita.Medico != null)
                                        {
                                            <span class="fw-semibold">
                                                @cita.Medico.Nombres
                                                @(" ")
                                                @cita.Medico.Apellidos
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Sin datos
                                            </span>
                                        }

                                    </td>


                                    <!-- FECHA -->

                                    <td>
                                        @cita.Fecha.ToString("dd/MM/yyyy")
                                    </td>


                                    <!-- HORA -->

                                    <td>

                                        <span class="fw-semibold">
                                            @cita.Hora.ToString(@"hh\:mm")
                                        </span>

                                    </td>


                                    <!-- MOTIVO -->

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(cita.Motivo))
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }
                                        else
                                        {
                                            @cita.Motivo
                                        }

                                    </td>


                                    <!-- ESTADO -->

                                    <td>

                                        <span class="badge @badge px-3 py-2">
                                            @cita.Estado
                                        </span>

                                    </td>


                                    <!-- ACCIONES -->

                                    <td>

                                        <!-- DETALLE -->

                                        <a asp-action="Detalle"
                                           asp-route-id="@cita.Id_Cita"
                                           class="btn btn-warning btn-sm"
                                           title="Ver detalle">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <!-- EDITAR -->
                                        @if (cita.Estado == EstadoCita.PENDIENTE)
                                        {
                                            <a asp-action="Editar"
                                               asp-route-id="@cita.Id_Cita"
                                               class="btn btn-primary btn-sm"
                                               title="Editar">

                                                <i class="bi bi-pencil"></i>

                                            </a>
                                        }


                                        <!-- CANCELAR -->
                                        @if (cita.Estado == EstadoCita.PENDIENTE)
                                        {
                                            <form asp-action="Cancelar"
                                                  asp-route-id="@cita.Id_Cita"
                                                  method="post"
                                                  class="d-inline"
                                                  id="formCancelar-@cita.Id_Cita">

                                                @Html.AntiForgeryToken()

                                                <button type="button"
                                                        class="btn btn-danger btn-sm"
                                                        title="Cancelar cita"
                                                        onclick="confirmarCancelar(@cita.Id_Cita)">

                                                    <i class="bi bi-x-circle"></i>

                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-muted py-5">

                                    <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>

                                    @if (hayBusqueda)
                                    {
                                        <span>
                                            No se encontraron citas.
                                        </span>
                                    }
                                    else if (!verTodas)
                                    {
                                        <span>
                                            No hay citas pendientes.
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            No hay citas registradas.
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
    ```

</div>

<!-- CONFIRMAR CANCELACIÓN -->

<script>

    function confirmarCancelar(id) {

        Swal.fire({

            title: "¿Cancelar cita?",

            text: "La cita quedará registrada como cancelada.",

            icon: "warning",

            showCancelButton: true,

            confirmButtonText: "Sí, cancelar",

            cancelButtonText: "No",

            reverseButtons: true

        }).then((result) => {

            if (result.isConfirmed) {

                const formulario =
                    document.getElementById("formCancelar-" + id);

                if (formulario) {

                    formulario.submit();

                }

            }

        });

    }

</script>

<!-- MENSAJE DE ÉXITO -->
@if (TempData["Success"] != null)
{
     <script>

              Swal.fire({

                  icon: 'success',

                  title: 'Correcto',

                  text: '@TempData["Success"]',

                  confirmButtonText: 'Aceptar'

              });

    </script>


}

<!-- MENSAJE DE ERROR -->
@if (TempData["Error"] != null)
{
     <script>

          ```
              Swal.fire({

                  icon: 'error',

                  title: 'Error',

                  text: '@TempData["Error"]',

                  confirmButtonText: 'Aceptar'

              });

    </script>


}
