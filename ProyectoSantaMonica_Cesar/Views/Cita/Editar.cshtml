@model ProyectoSantaMonica_Cesar.Models.Cita

@{
    ViewData["Title"] = "Editar Cita";
}

<title>Editar Cita</title>

<!-- ==========================================================
     ICONOS Y FUENTES
     Bootstrap ya es cargado por _LayoutRecepcionista
     ========================================================== -->

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet">


<style>

    /* ==========================================================
           GENERAL
           ========================================================== */

    body {
        background-color: #f4f7fb;
        font-family: 'Poppins', sans-serif;
        color: #333;
    }


    /* ==========================================================
           HEADER
           ========================================================== */

    .header-bar {
        background-color: #007bff;
        color: white;
        min-height: 70px;
        border-radius: 12px;
        padding: 15px 25px;
        display: flex;
        align-items: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        margin-bottom: 30px;
    }

        .header-bar h4 {
            font-weight: 600;
            font-size: 1.3rem;
            margin: 0;
            display: flex;
            align-items: center;
        }


    /* ==========================================================
           CARD
           ========================================================== */

    .card-form {
        background-color: #fff;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        margin-bottom: 30px;
    }

        .card-form label {
            font-weight: 500;
            font-size: 0.9rem;
        }

        .card-form input.form-control,
        .card-form select.form-select,
        .card-form textarea.form-control {
            font-size: 0.9rem;
        }


    /* ==========================================================
           BOTONES
           ========================================================== */

    .btn-success {
        background-color: #28c76f;
        border: none;
        font-weight: 600;
    }

        .btn-success:hover {
            background-color: #22b365;
        }

    .btn-info {
        background-color: #17a2b8;
        color: white;
        font-weight: 600;
    }

        .btn-info:hover {
            background-color: #138496;
            color: white;
        }

    .btn-ver-horarios {
        background-color: #6c757d;
        color: white;
        font-weight: 600;
    }


    /* ==========================================================
           FECHA / HORA
           ========================================================== */

    .d-flex-hora {
        display: flex;
        gap: .5rem;
        align-items: stretch;
        width: 100%;
    }

    /*
           Bootstrap 5 utiliza aproximadamente 38px
           para form-control/form-select.
        */

    #fechaCita,
    #horaCita {
        height: 38px;
    }

    #horaCita {
        flex: 1 1 auto;
        min-width: 0;
    }

    #btnVerHorarios {
        height: 38px;
        white-space: nowrap;
        flex-shrink: 0;
    }


    /* ==========================================================
           MODAL
           ========================================================== */

    .modal-dialog {
        max-width: 800px;
    }

    .modal-header {
        background-color: #007bff;
        color: white;
    }


    /* ==========================================================
           ALERTAS
           ========================================================== */

    .alert-custom {
        border-radius: 10px;
        font-size: .95rem;
    }

</style>


<div class="container mt-4">

    <!-- ======================================================
         HEADER
         ====================================================== -->

    <div class="header-bar">

        <h4>
            <i class="bi bi-pencil-square me-2"></i>
            Editar Cita
        </h4>

    </div>


    <!-- ======================================================
         ALERTA ERROR
         ====================================================== -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show alert-custom">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ======================================================
         ALERTA SUCCESS
         ====================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show alert-custom">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ======================================================
         FORMULARIO
         ====================================================== -->

    <div class="card-form">

        <form asp-action="Editar"
              method="post">

            @Html.AntiForgeryToken()


            <!-- ==================================================
                 ID DE CITA
                 ================================================== -->

            <input type="hidden"
                   asp-for="Id_Cita"
                   id="Id_Cita" />


            <!-- ==================================================
                 VALIDACIONES
                 ================================================== -->

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>


            <!-- ==================================================
                 PACIENTE
                 ================================================== -->

            <div class="mb-3">

                <label class="form-label">
                    Paciente
                </label>

                <div class="input-group">

                    <input type="text"
                           id="pacienteNombre"
                           class="form-control"
                           readonly
                           value="@($"{Model.Paciente?.Nombres} {Model.Paciente?.Apellidos}".Trim())" />

                    <input type="hidden"
                           asp-for="Id_Paciente"
                           id="pacienteId" />

                    <button type="button"
                            class="btn btn-info"
                            data-bs-toggle="modal"
                            data-bs-target="#modalPacientes">

                        <i class="bi bi-search"></i>

                    </button>

                </div>

                <span asp-validation-for="Id_Paciente"
                      class="text-danger">
                </span>

            </div>


            <!-- ==================================================
                 MEDICO
                 ================================================== -->

            <div class="mb-3">

                <label class="form-label">
                    Médico
                </label>

                <div class="input-group">

                    <input type="text"
                           id="medicoNombre"
                           class="form-control"
                           readonly
                           value="@($"{Model.Medico?.Nombres} {Model.Medico?.Apellidos}".Trim())@(string.IsNullOrWhiteSpace(Model.Medico?.Especialidad) ? "" : $" — {Model.Medico.Especialidad}")" />

                    <input type="hidden"
                           asp-for="Id_Medico"
                           id="medicoId" />

                    <button type="button"
                            class="btn btn-info"
                            data-bs-toggle="modal"
                            data-bs-target="#modalMedicos">

                        <i class="bi bi-search"></i>

                    </button>

                </div>

                <span asp-validation-for="Id_Medico"
                      class="text-danger">
                </span>

            </div>


            <!-- ==================================================
                 FECHA Y HORA
                 ================================================== -->

            <div class="row mb-3">


                <!-- ==================================================
                     FECHA
                     ================================================== -->

                <div class="col-md-6">

                    <label class="form-label">
                        Fecha
                    </label>

                    <input type="date"
                           asp-for="Fecha"
                           class="form-control"
                           id="fechaCita"
                           value="@Model.Fecha.ToString("yyyy-MM-dd")" />

                    <span asp-validation-for="Fecha"
                          class="text-danger">
                    </span>

                </div>


                <!-- ==================================================
                     HORA
                     ================================================== -->

                <div class="col-md-6">

                    <label class="form-label">
                        Hora
                    </label>

                    <div class="d-flex-hora">

                        <select asp-for="Hora"
                                class="form-select"
                                id="horaCita">

                            <option value="">
                                Cargando horarios...
                            </option>

                        </select>


                        <button type="button"
                                id="btnVerHorarios"
                                class="btn btn-info"
                                onclick="abrirHorarios()">

                            Ver horarios

                        </button>

                    </div>

                    <span asp-validation-for="Hora"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <!-- ==================================================
                 MOTIVO
                 ================================================== -->

            <div class="mb-3">

                <label class="form-label">
                    Motivo
                </label>

                <textarea asp-for="Motivo"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Motivo"
                      class="text-danger">
                </span>

            </div>


            <!-- ==================================================
                 CONTENEDOR DEL MODAL DE HORARIOS
                 ================================================== -->

            <div id="modalHorariosContainer"></div>


            <!-- ==================================================
                 BOTONES
                 ================================================== -->

            <div class="d-flex justify-content-between">

                <a asp-action="Listar"
                   class="btn btn-secondary w-50 me-1">

                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-success w-50 ms-1">

                    Guardar cambios

                </button>

            </div>

        </form>

    </div>

</div>


<!-- ==========================================================
     MODAL PACIENTE
     ========================================================== -->

<partial name="~/Views/Shared/_modalSeleccionarPaciente.cshtml"
         model="ViewBag.Pacientes" />


<!-- ==========================================================
     MODAL MEDICO
     ========================================================== -->

<partial name="~/Views/Shared/_modalSeleccionarMedico.cshtml"
         model="ViewBag.Medicos" />


@section Scripts {

    <!-- ======================================================
         VALIDACIONES
         ====================================================== -->

    <partial name="_ValidationScriptsPartial" />


    <!-- ======================================================
         SWEETALERT
         ====================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                // =================================================
                // CONTROLES
                // =================================================

                const medicoInput =
                    document.getElementById("medicoId");

                const fechaInput =
                    document.getElementById("fechaCita");

                const horaSelect =
                    document.getElementById("horaCita");

                const idCitaInput =
                    document.getElementById("Id_Cita");

                const pacienteInput =
                    document.getElementById("pacienteId");


                // =================================================
                // VALIDAR CONTROLES
                // =================================================

                if (!medicoInput ||
                    !fechaInput ||
                    !horaSelect) {

                    console.error(
                        "No se encontraron los controles necesarios para Editar Cita."
                    );

                    return;
                }


                // =================================================
                // FECHA LOCAL DE HOY
                // =================================================

                function obtenerFechaLocal() {

                    const ahora =
                        new Date();

                    return `${ahora.getFullYear()}-${String(
                        ahora.getMonth() + 1
                    ).padStart(2, "0")}-${String(
                        ahora.getDate()
                    ).padStart(2, "0")}`;
                }


                const hoy =
                    obtenerFechaLocal();


                // =================================================
                // DATOS ORIGINALES
                // =================================================

                const medicoOriginal =
                    medicoInput.value;

                const fechaOriginal =
                    '@Model.Fecha.ToString("yyyy-MM-dd")';

                const horaOriginal =
                    '@Model.Hora.ToString(@"hh\:mm")';

                const idMedicoOriginal =
                    '@Model.Id_Medico';


                // =================================================
                // FECHA MINIMA
                // =================================================

                fechaInput.min = hoy;


                // =================================================
                // CARGAR HORAS DISPONIBLES
                // =================================================

                async function cargarHorasDisponibles() {

                    const idMedico =
                        medicoInput.value.trim();

                    const fecha =
                        fechaInput.value;

                    const idCita =
                        idCitaInput
                            ? idCitaInput.value
                            : "0";


                    // ---------------------------------------------
                    // LIMPIAR SELECT
                    // ---------------------------------------------

                    horaSelect.innerHTML = "";

                    horaSelect.disabled = true;


                    // ---------------------------------------------
                    // VALIDAR MEDICO
                    // ---------------------------------------------

                    if (!idMedico) {

                        horaSelect.innerHTML =
                            '<option value="">Seleccione primero un médico</option>';

                        return;
                    }


                    // ---------------------------------------------
                    // VALIDAR FECHA
                    // ---------------------------------------------

                    if (!fecha) {

                        horaSelect.innerHTML =
                            '<option value="">Seleccione una fecha</option>';

                        return;
                    }


                    // ---------------------------------------------
                    // VALIDAR FECHA ANTERIOR
                    // ---------------------------------------------

                    if (fecha < hoy) {

                        horaSelect.innerHTML =
                            '<option value="">Fecha no válida</option>';

                        return;
                    }


                    // ---------------------------------------------
                    // CARGANDO
                    // ---------------------------------------------

                    horaSelect.innerHTML =
                        '<option value="">Cargando horarios...</option>';


                    try {

                        const url =
                            `/Cita/HorasDisponibles?idMedico=${encodeURIComponent(idMedico)}&fecha=${encodeURIComponent(fecha)}&idCita=${encodeURIComponent(idCita)}`;


                        const response =
                            await fetch(url);


                        if (!response.ok) {

                            throw new Error(
                                `Error HTTP ${response.status}`
                            );
                        }


                        const data =
                            await response.json();


                        horaSelect.innerHTML = "";


                        // -----------------------------------------
                        // SIN HORAS
                        // -----------------------------------------

                        if (!data.ok ||
                            !data.horas ||
                            data.horas.length === 0) {

                            const option =
                                document.createElement("option");

                            option.value = "";

                            option.textContent =
                                data.mensaje ||
                                "No hay horas disponibles";

                            horaSelect.appendChild(option);

                            return;
                        }


                        // -----------------------------------------
                        // OPCION INICIAL
                        // -----------------------------------------

                        const inicial =
                            document.createElement("option");

                        inicial.value = "";

                        inicial.textContent =
                            "Seleccione una hora";

                        horaSelect.appendChild(
                            inicial
                        );


                        // -----------------------------------------
                        // HORAS
                        // -----------------------------------------

                        data.horas.forEach(
                            function (hora) {

                                const option =
                                    document.createElement(
                                        "option"
                                    );


                                option.value =
                                    hora;

                                option.textContent =
                                    hora;


                                /*
                                 * SOLAMENTE conservar la hora
                                 * original si seguimos usando:
                                 *
                                 * 1. el mismo médico
                                 * 2. la misma fecha
                                 *
                                 * Si se cambia de médico, no
                                 * debemos seleccionar automáticamente
                                 * la hora del médico anterior.
                                 */

                                if (
                                    String(idMedico) ===
                                    String(idMedicoOriginal) &&

                                    fecha ===
                                    fechaOriginal &&

                                    hora ===
                                    horaOriginal
                                ) {

                                    option.selected =
                                        true;
                                }


                                horaSelect.appendChild(
                                    option
                                );

                            }
                        );


                        horaSelect.disabled =
                            false;

                    }
                    catch (error) {

                        console.error(
                            "Error cargando horarios de edición:",
                            error
                        );


                        horaSelect.innerHTML =
                            '<option value="">No se pudieron cargar los horarios</option>';
                    }

                }


                // =================================================
                // CAMBIO DE MEDICO
                // =================================================

                medicoInput.addEventListener(
                    "change",
                    function () {

                        /*
                         * Cuando se selecciona otro médico,
                         * se cargan nuevamente sus horarios.
                         */

                        cargarHorasDisponibles();

                    }
                );


                // =================================================
                // CAMBIO DE FECHA
                // =================================================

                fechaInput.addEventListener(
                    "change",
                    function () {

                        const nuevaFecha =
                            this.value;


                        if (nuevaFecha < hoy) {

                            Swal.fire(
                                "Fecha no válida",
                                "No puede seleccionar una fecha anterior a hoy.",
                                "warning"
                            );


                            this.value =
                                hoy;
                        }


                        cargarHorasDisponibles();

                    }
                );


                // =================================================
                // CARGA INICIAL
                // =================================================

                cargarHorasDisponibles();


                // =================================================
                // BUSQUEDA DE PACIENTES
                // =================================================

                const buscarPacienteInput =
                    document.getElementById(
                        "buscarPacienteInput"
                    );

                const btnBuscarPaciente =
                    document.getElementById(
                        "btnBuscarPaciente"
                    );


                if (buscarPacienteInput) {

                    buscarPacienteInput.addEventListener(
                        "keydown",
                        function (event) {

                            if (event.key === "Enter") {

                                event.preventDefault();

                                buscarPaciente();

                            }

                        }
                    );


                    buscarPacienteInput.addEventListener(
                        "input",
                        function () {

                            buscarPaciente();

                        }
                    );

                }


                if (btnBuscarPaciente) {

                    btnBuscarPaciente.addEventListener(
                        "click",
                        function () {

                            buscarPaciente();

                        }
                    );

                }

            }
        );


        // ==========================================================
        // BUSCAR PACIENTE
        // ==========================================================

        async function buscarPaciente() {

            const input =
                document.getElementById(
                    "buscarPacienteInput"
                );


            const tbody =
                document.querySelector(
                    "#tablaPacientes tbody"
                );


            if (!input || !tbody) {

                return;
            }


            const texto =
                input.value.trim();


            try {

                const response =
                    await fetch(
                        `/Paciente/Buscar?texto=${encodeURIComponent(texto)}`
                    );


                if (!response.ok) {

                    throw new Error(
                        `Error HTTP ${response.status}`
                    );
                }


                const pacientes =
                    await response.json();


                tbody.innerHTML = "";


                if (!pacientes ||
                    pacientes.length === 0) {

                    tbody.innerHTML =
                        `
                        <tr>
                            <td colspan="4"
                                class="text-center text-muted">
                                No se encontraron pacientes.
                            </td>
                        </tr>
                        `;

                    return;
                }


                pacientes.forEach(
                    function (p) {

                        const nombreCompleto =
                            `${p.nombres ?? ""} ${p.apellidos ?? ""}`
                                .trim();


                        const tr =
                            document.createElement("tr");


                        tr.innerHTML =
                            `
                            <td>${p.id_Paciente ?? p.id}</td>

                            <td>${p.nombres ?? ""}</td>

                            <td>${p.apellidos ?? ""}</td>

                            <td>
                                <button
                                    type="button"
                                    class="btn btn-sm btn-primary"
                                    onclick="seleccionarPaciente(${p.id_Paciente ?? p.id}, '${nombreCompleto.replace(/'/g, "\\'")}')">
                                    Seleccionar
                                </button>
                            </td>
                            `;


                        tbody.appendChild(tr);

                    }
                );

            }
            catch (error) {

                console.error(
                    "Error buscando pacientes:",
                    error
                );

            }

        }


        // ==========================================================
        // SELECCIONAR PACIENTE
        // ==========================================================

        function seleccionarPaciente(
            id,
            nombre
        ) {

            const pacienteId =
                document.getElementById(
                    "pacienteId"
                );

            const pacienteNombre =
                document.getElementById(
                    "pacienteNombre"
                );


            if (pacienteId) {

                pacienteId.value =
                    id;

            }


            if (pacienteNombre) {

                pacienteNombre.value =
                    nombre;

            }


            const modalElement =
                document.getElementById(
                    "modalPacientes"
                );


            if (modalElement) {

                const modal =
                    bootstrap.Modal.getInstance(
                        modalElement
                    );


                if (modal) {

                    modal.hide();

                }

            }

        }


        // ==========================================================
        // ALERTAS TEMP DATA
        // ==========================================================

        @if (TempData["Error"] != null)
        {
            <text>

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: @Html.Raw(
                       System.Text.Json.JsonSerializer.Serialize(
                           TempData["Error"]?.ToString()
                       )
                   ),
                        confirmButtonColor: '#d33'
                    });

            </text>
        }


        @if (TempData["Success"] != null)
        {
            <text>

                    Swal.fire({
                        icon: 'success',
                        title: 'Correcto',
                        text: @Html.Raw(
                       System.Text.Json.JsonSerializer.Serialize(
                           TempData["Success"]?.ToString()
                       )
                   ),
                        confirmButtonColor: '#28c76f'
                    });

            </text>
        }

    </script>
}